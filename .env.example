# Copy this file to `.env.local` (gitignored via the `*.local` rule) and fill in
# the values from your Supabase project → Settings → API.
#
# Both are PUBLIC values, safe to ship in the client bundle. All data protection
# rests on Row-Level Security policies (supabase/migrations). Never put the
# service_role key here — it bypasses RLS.
#
# Leaving these unset keeps Nudge in its original local-only / anonymous mode.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
